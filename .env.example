# ==============================================================================
# 🏦 Banking Production Agentic Chat — Environment Configuration Template
# Copy this file to .env and configure for local or production deployments:
#   cp .env.example .env
# ==============================================================================

# ─── Application Core ───
APP_NAME=banking-agentic-chat
APP_ENV=development              # Options: development | staging | production
APP_PORT=8000
APP_LOG_LEVEL=INFO               # Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_SECRET_KEY=change-me-use-openssl-rand-hex-32-for-jwt-signing

# ─── Authentication & JWT Token Rotation (Localhost IdP / Keycloak) ───
AUTH_IDP_ISSUER=http://localhost:8080/realms/banking
AUTH_IDP_JWKS_URL=http://localhost:8080/realms/banking/protocol/openid-connect/certs
AUTH_IDP_CLIENT_ID=banking-chat-app
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRY_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── LLM Gateway 1: Primary Free Model (OpenCode Zen API) ───
LLM_SELF_HOSTED_BASE_URL=https://opencode.ai/zen/v1
LLM_SELF_HOSTED_MODEL=laguna-s-2.1-free
LLM_SELF_HOSTED_MAX_TOKENS=2048
LLM_SELF_HOSTED_TEMPERATURE=0.1

# ─── LLM Gateway 2: Advanced Reasoning Free Model (OpenCode Zen API) ───
LLM_OPENAI_API_KEY=your-opencode-zen-key
LLM_OPENAI_BASE_URL=https://opencode.ai/zen/v1
LLM_OPENAI_MODEL=laguna-s-2.1-free
LLM_OPENAI_MAX_TOKENS=2048
LLM_OPENAI_TEMPERATURE=0.2

# ─── Redis (Session Memory & Rate Limiting) ───
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=1800

# ─── Database (PostgreSQL for production, SQLite for local dev) ───
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/banking_chat
# DATABASE_URL=sqlite+aiosqlite:///./banking_chat_dev.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=banking_chat

# ─── Standalone Streamable HTTP MCP Microservices ───
MCP_ACCOUNTS_URL=http://localhost:9001
MCP_TRANSACTIONS_URL=http://localhost:9002
MCP_SERVICES_URL=http://localhost:9003

# ─── Observability & Tracing ───
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=banking-agentic-chat
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Cost Tracking & Budget Guardrails (USD) ───
COST_DAILY_BUDGET_USD=500.00
COST_MONTHLY_BUDGET_USD=10000.00
COST_PER_INTERACTION_WARN_USD=0.10
COST_PER_INTERACTION_LIMIT_USD=0.50

# ─── Tiered Rate Limiting (Requests Per Minute) ───
RATE_LIMIT_STANDARD_RPM=20
RATE_LIMIT_PREMIUM_RPM=40
RATE_LIMIT_PRIVILEGED_RPM=60
